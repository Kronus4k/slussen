{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GetRegistryToken",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "PullValidatorImage",
      "Effect": "Allow",
      "Action": ["ecr:BatchGetImage", "ecr:GetDownloadUrlForLayer", "ecr:BatchCheckLayerAvailability"],
      "Resource": "arn:aws:ecr:__REGION__:__ACCOUNT__:repository/slussen-validator"
    },
    {
      "Sid": "WriteTaskLogs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:__REGION__:__ACCOUNT__:log-group:/ecs/slussen-validator:*"
    }
  ]
}