{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListLakeBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::__BUCKET__"
    },
    {
      "Sid": "ReadAndClearLanding",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:DeleteObject"],
      "Resource": [
        "arn:aws:s3:::__BUCKET__/landing/ops/*",
        "arn:aws:s3:::__BUCKET__/landing/finance/*",
        "arn:aws:s3:::__BUCKET__/landing/olist/*"
      ]
    },
    {
      "Sid": "WriteOutputZones",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": [
        "arn:aws:s3:::__BUCKET__/validated/*",
        "arn:aws:s3:::__BUCKET__/quarantine/*"
      ]
    },
    {
      "Sid": "WriteViolationLog",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::__BUCKET__/audit/contract_violations/*"
    },
    {
      "Sid": "UseLakeKey",
      "Effect": "Allow",
      "Action": ["kms:Decrypt", "kms:GenerateDataKey"],
      "Resource": "__KMS_KEY_ARN__"
    },
    {
      "Sid": "ReportOutcomeToGate",
      "Effect": "Allow",
      "Action": ["states:SendTaskSuccess", "states:SendTaskFailure"],
      "Resource": "arn:aws:states:__REGION__:__ACCOUNT__:stateMachine:slussen-contract-gate"
    }
  ]
}