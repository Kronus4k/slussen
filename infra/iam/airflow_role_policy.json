{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListLakeBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::slussen-lake-qwer"
    },
    {
      "Sid": "ReadAirflowConnectionSecrets",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "arn:aws:secretsmanager:eu-north-1:__ACCOUNT_ID__:secret:slussen/airflow/connections/*"
    },
    {
      "Sid": "PublishProducerBatches",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": [
        "arn:aws:s3:::slussen-lake-qwer/landing/ops/orders/*",
        "arn:aws:s3:::slussen-lake-qwer/landing/finance/settlements/*"
      ]
    },
    {
      "Sid": "ReadGeneratorSources",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::slussen-lake-qwer/validated/olist/order_items/*",
        "arn:aws:s3:::slussen-lake-qwer/validated/olist/customers/*",
        "arn:aws:s3:::slussen-lake-qwer/validated/ops/orders/*"
      ]
    },
    {
      "Sid": "ReadDecisionMarkersOnly",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::slussen-lake-qwer/validated/finance/settlements/*_SUCCESS",
        "arn:aws:s3:::slussen-lake-qwer/quarantine/ops/orders/*_SUCCESS",
        "arn:aws:s3:::slussen-lake-qwer/quarantine/finance/settlements/*_SUCCESS"
      ]
    },
    {
      "Sid": "RunReconciliationQueries",
      "Effect": "Allow",
      "Action": [
        "athena:StartQueryExecution",
        "athena:GetQueryExecution",
        "athena:GetQueryResults",
        "athena:StopQueryExecution"
      ],
      "Resource": "arn:aws:athena:eu-north-1:__ACCOUNT_ID__:workgroup/slussen"
    },
    {
      "Sid": "ReadReconciledTableDefinitions",
      "Effect": "Allow",
      "Action": ["glue:GetDatabase", "glue:GetTable", "glue:GetPartitions"],
      "Resource": [
        "arn:aws:glue:eu-north-1:__ACCOUNT_ID__:catalog",
        "arn:aws:glue:eu-north-1:__ACCOUNT_ID__:database/slussen_lake",
        "arn:aws:glue:eu-north-1:__ACCOUNT_ID__:table/slussen_lake/ops_orders",
        "arn:aws:glue:eu-north-1:__ACCOUNT_ID__:table/slussen_lake/olist_order_items",
        "arn:aws:glue:eu-north-1:__ACCOUNT_ID__:table/slussen_lake/olist_customers"
      ]
    },
    {
      "Sid": "WriteAthenaResults",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:AbortMultipartUpload"],
      "Resource": "arn:aws:s3:::slussen-lake-qwer/athena-results/*"
    },
    {
      "Sid": "LakeKeyViaS3Only",
      "Effect": "Allow",
      "Action": ["kms:GenerateDataKey", "kms:Decrypt"],
      "Resource": "__KMS_KEY_ARN__",
      "Condition": {
        "StringEquals": { "kms:ViaService": "s3.eu-north-1.amazonaws.com" }
      }
    }
  ]
}