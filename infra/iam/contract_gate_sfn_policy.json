{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListBatchFiles",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::__BUCKET__",
      "Condition": {
        "StringLike": { "s3:prefix": ["landing/ops/*", "landing/finance/*", "landing/olist/*"] }
      }
    },
    {
      "Sid": "InvokeGate",
      "Effect": "Allow",
      "Action": "lambda:InvokeFunction",
      "Resource": [
        "arn:aws:lambda:__REGION__:__ACCOUNT__:function:slussen-validator",
        "arn:aws:lambda:__REGION__:__ACCOUNT__:function:slussen-validator:*"
      ]
    },
    {
      "Sid": "RunGateTask",
      "Effect": "Allow",
      "Action": "ecs:RunTask",
      "Resource": "arn:aws:ecs:__REGION__:__ACCOUNT__:task-definition/slussen-validator:*",
      "Condition": {
        "ArnEquals": { "ecs:cluster": "arn:aws:ecs:__REGION__:__ACCOUNT__:cluster/slussen-gate" }
      }
    },
    {
      "Sid": "PassGateTaskRoles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::__ACCOUNT__:role/slussen-validator-task",
        "arn:aws:iam::__ACCOUNT__:role/slussen-validator-task-execution"
      ],
      "Condition": {
        "StringEquals": { "iam:PassedToService": "ecs-tasks.amazonaws.com" }
      }
    },
    {
      "Sid": "PublishAlerts",
      "Effect": "Allow",
      "Action": "sns:Publish",
      "Resource": "arn:aws:sns:__REGION__:__ACCOUNT__:slussen-contract-alerts"
    }
  ]
}