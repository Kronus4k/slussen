{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DataEngineerSsoSessionOnly",
      "Effect": "Allow",
      "Principal": { "AWS": "arn:aws:iam::__ACCOUNT_ID__:root" },
      "Action": "sts:AssumeRole",
      "Condition": {
        "ArnLike": {
          "aws:PrincipalArn": "arn:aws:iam::__ACCOUNT_ID__:role/aws-reserved/sso.amazonaws.com/*/AWSReservedSSO_DataEngineer_*"
        }
      }
    }
  ]
}