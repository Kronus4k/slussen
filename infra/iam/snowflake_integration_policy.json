{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectVersion"],
      "Resource": [
        "arn:aws:s3:::__BUCKET__/validated/*",
        "arn:aws:s3:::__BUCKET__/audit/contract_violations/*"
      ]
    },
    {
      "Sid": "ListPrefixes",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::__BUCKET__",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["validated/*", "audit/contract_violations/*"]
        }
      }
    },
    {
      "Sid": "BucketLocation",
      "Effect": "Allow",
      "Action": "s3:GetBucketLocation",
      "Resource": "arn:aws:s3:::__BUCKET__"
    },
    {
      "Sid": "DecryptWithLakeKey",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "__KMS_KEY_ARN__"
    }
  ]
}