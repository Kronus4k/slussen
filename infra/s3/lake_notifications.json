{
  "EventBridgeConfiguration": {},
  "QueueConfigurations": [
    {
      "Id": "snowpipe-validated",
      "QueueArn": "__SNOWPIPE_QUEUE_ARN__",
      "Events": ["s3:ObjectCreated:*"],
      "Filter": {
        "Key": {
          "FilterRules": [
            { "Name": "prefix", "Value": "validated/" },
            { "Name": "suffix", "Value": ".parquet" }
          ]
        }
      }
    },
    {
      "Id": "snowpipe-audit",
      "QueueArn": "__SNOWPIPE_QUEUE_ARN__",
      "Events": ["s3:ObjectCreated:*"],
      "Filter": {
        "Key": {
          "FilterRules": [
            { "Name": "prefix", "Value": "audit/contract_violations/" },
            { "Name": "suffix", "Value": ".jsonl" }
          ]
        }
      }
    }
  ]
}